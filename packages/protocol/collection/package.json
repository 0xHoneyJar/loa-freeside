{
  "name": "@freeside/collection-protocol",
  "version": "1.0.0",
  "description": "Versioned cross-VM collection identity, capability-version, canonical digest, and finality-bound wire contracts.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "import": "./dist/harness/index.js"
    }
  },
  "bin": {
    "collection-protocol-pack": "./scripts/pack-artifact.mjs",
    "collection-protocol-verify": "./scripts/verify-artifact.mjs"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "dist/harness",
    "fixtures",
    "scripts",
    "pins",
    "protocol-identity.json",
    "README.md",
    "CONSUMER.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tmp *.tsbuildinfo protocol-identity.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack:artifact": "node ./scripts/pack-artifact.mjs",
    "verify:artifact": "node ./scripts/verify-artifact.mjs",
    "ci:compat": "./scripts/ci-compat.sh"
  },
  "license": "AGPL-3.0",
  "peerDependencies": {
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "effect": "^3.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.17"
  },
  "publishConfig": {
    "access": "public"
  }
}
