{
  "name": "@0xhoneyjar/freeside-cli",
  "version": "0.1.0",
  "description": "Ecosystem CLI for the freeside building network. `loa freeside list|inspect|doctor|catalog` verbs per ADR-007 §D-6 + ADR-008 §D-11.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "freeside-cli": "./dist/bin/freeside-cli.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && chmod +x dist/bin/freeside-cli.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@0xhoneyjar/freeside-registry": "file:../freeside-registry",
    "@0xhoneyjar/beacon-schema": "file:../beacon-schema",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.4.0",
    "@types/node": "^22.0.0"
  }
}
