{
  "name": "@freeside/ordering-service",
  "version": "0.1.0",
  "description": "Order intake + thin orchestrator for the Freeside order system (durable order-state store, idempotency, outbox, capability resolver PORT, audit ACL). Platform-scoped; the Ordering bounded context's runtime (EVANS).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "tsx bin/http.ts",
    "dev": "tsx watch bin/http.ts"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@freeside/ordering-protocol": "file:../../protocol/ordering",
    "@freeside/shadow-audit-protocol": "file:../../protocol/shadow-audit",
    "@freeside/shadow-audit-service": "file:../shadow-audit",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.7.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  }
}
